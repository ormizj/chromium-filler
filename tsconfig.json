{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vitest/globals"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  // `dev` is in because the harness renders the *real* modal and setup panel
  // from hand-written fixture data, so it drifts against `ModalData`/`SetupData`
  // silently — and did: a required field was added to `SyncState` and the
  // harness's mock went on claiming to return one. `e2e` is deliberately out;
  // it is Node code and would need `@types/node` plus a declaration for the
  // `.mjs` scenario catalog to compile here.
  "include": [
    "src",
    "test",
    "dev",
    "manifest.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
